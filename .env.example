# 生产环境必须设置；本地开发未设置时可使用 ricky-local 登录。
RICKY_ADMIN_PASSWORD=
RICKY_ADMIN_SESSION_SECRET=

# 用于加密模型 API Key；生产环境请单独设置且保持稳定。
RICKY_SECRETS_KEY=

# 可选：内容草稿、正式版本和历史快照的持久化目录。
RICKY_CONTENT_DATA_DIR=.ricky-twin-data

# 私有 GitHub Releases 检查更新。Token 只授予本仓库 Contents: Read。
RICKY_UPDATE_REPOSITORY=Ricky940828/ricky.twin
RICKY_GITHUB_RELEASE_TOKEN=
